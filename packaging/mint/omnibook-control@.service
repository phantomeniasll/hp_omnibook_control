[Unit]
Description=HP OmniBook privileged control request

[Service]
ExecStart=/usr/local/lib/omnibook-fan-curves/curve-python /usr/local/lib/omnibook-fan-curves/control_runner.py serve
StandardInput=socket
StandardOutput=journal
StandardError=journal
RuntimeMaxSec=10
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/sys
ReadWritePaths=-/var/lib/omnibook-fan-curves -/run/omnibook-fan-curves -/var/lib/omnibook-charge-limit
ReadWritePaths=-/sys/devices/platform/hp-wmi/platform-profile
