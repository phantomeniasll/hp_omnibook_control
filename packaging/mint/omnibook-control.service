[Unit]
Description=HP OmniBook privileged control listener

BindsTo=omnibook-control.socket
After=omnibook-control.socket

[Service]
ExecStart=/usr/local/lib/omnibook-fan-curves/curve-python /usr/local/lib/omnibook-fan-curves/control_runner.py listen
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=1
TasksMax=24
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/sys
ReadWritePaths=-/var/lib/omnibook-fan-curves -/run/omnibook-fan-curves -/var/lib/omnibook-charge-limit
ReadWritePaths=-/sys/devices/platform/hp-wmi/platform-profile
