[Unit]
Description=HP OmniBook battery charge limit
After=systemd-modules-load.service
ConditionPathExistsGlob=/sys/class/power_supply/BAT*

[Service]
ExecStartPre=-/usr/local/lib/omnibook-fan-curves/curve-python /usr/local/lib/omnibook-fan-curves/battery_limit.py load-driver
ExecStart=/usr/local/lib/omnibook-fan-curves/curve-python /usr/local/lib/omnibook-fan-curves/battery_limit.py run
StateDirectory=omnibook-charge-limit
RuntimeDirectory=omnibook-charge-limit
StateDirectoryMode=0755
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
