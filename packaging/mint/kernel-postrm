#!/bin/sh
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

kver="${1:-}"
case "$kver" in
    ""|*[!A-Za-z0-9._+-]*|.*|*-) exit 0 ;;
esac

case "${DEB_MAINT_PARAMS:-}" in
    ""|remove|remove\ *|purge|purge\ *) ;;
    *) exit 0 ;;
esac

cleanup() {
    result=$?
    if [ "$result" -ne 0 ]; then
        printf 'omnibook-fan-curves: warning: module cleanup failed (kernel %s).\n' "$kver" >&2
    fi
    exit 0
}
trap cleanup EXIT

exec 9>/run/omnibook-install.lock
flock -x 9

[ "$kver" != "$(uname -r)" ] || exit 0
target="/usr/local/lib/omnibook-fan-curves/$kver"
if [ -d "$target" ] && [ ! -L "$target" ]; then
    rm -rf -- "$target"
fi
